;; defsrc is still necessary
(defcfg
  process-unmapped-keys yes
)

(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10   f11   f12
  a s d f j k l ; caps spc
  q w e r t g z x c v b
  m , . u i o n h y p
  fn
)
(defvar
  tap-time 300
  hold-time 200
)

(defalias
  a (tap-hold $tap-time $hold-time a lctl)
  s (tap-hold $tap-time $hold-time s lalt)
  d (tap-hold $tap-time $hold-time d lmet)
  f (tap-hold $tap-time $hold-time f lsft)
  j (tap-hold $tap-time $hold-time j rsft)
  k (tap-hold $tap-time $hold-time k rmet)
  l (tap-hold $tap-time $hold-time l lalt)
  ; (tap-hold $tap-time $hold-time ; rctl)
  caps (tap-hold 50 $hold-time esc lctl)
  spc (tap-hold $tap-time 200 spc (layer-while-held numbers))
  fnl (tap-hold 200 200 fn (layer-toggle fn))
  jj (tap-hold $tap-time $hold-time 4 rsft)
  kk (tap-hold $tap-time $hold-time 5 rmet)
  ll (tap-hold $tap-time $hold-time 6 lalt)
)

(deflayer base
  brdn  brup  _    _    _    _   prev  pp  next  mute  vold  volu
  @a @s @d @f @j @k @l @; @caps @spc
  q w e r t g z x c v b
  m , . u i o n h y p
  @fnl
)

(deflayer fn
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10   f11   f12
  _ _ _ _ _ _ _ _ _ _
  q w e r t g z x c v b
  _ _ _ _ _ _ _ _ _ _
  fn
)

;; Numbers layer: home row becomes numbers with symbols when shifted
(deflayer numbers
  _ _ _ _ _ _ _ _ _ _ _ _
  S-6 S-7 S-8 S-9 @jj @kk @ll _ _ _
  S-1 S-2 S-3 S-4 S-5 S-0 grv [ ] S-[ S-]
  1 2 3 7 8 9 . - + =
  fn
)
