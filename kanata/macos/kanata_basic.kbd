;; defsrc is still necessary
(defcfg
  process-unmapped-keys yes
)

(defsrc
  s d f j k l ; caps
)
(defvar
  tap-time 300
  hold-time 150
  hold-time-long 180
  hold-time-longer 220
)

(defalias
  s (tap-hold $tap-time 200 s lalt)
  d (tap-hold $tap-time 200 d lmet)
  f (tap-hold $tap-time 180 f lsft)
  j (tap-hold $tap-time 180 j rsft)
  k (tap-hold $tap-time 200 k rmet)
  l (tap-hold $tap-time 200 l lalt)
  ; (tap-hold $tap-time 180 ; rctl)
  caps (tap-hold 50 180 esc lctl)
)

(deflayer base
  @s @d @f @j @k @l @; @caps
)

(deflayer fn
 _ _ _ _ _ _ _ _
)
